{
  "Agent": {
    "HeartbeatIntervalMs": 10000,
    "CollectorIntervalMs": 1000,
    "BatchSendIntervalMs": 5000,
    "OfflineQueueMaxSize": 10000,
    "HealthCheckIntervalMs": 30000,
    "EnableScreenCapture": false,
    "ScreenCaptureQuality": 50,
    "ScreenCaptureIntervalMs": 300000,
    "EnableUsbTracking": true,
    "MonitoredProcessNames": []
  },
  "ServerConnection": {
    "ApiUrl": "https://sentinela-api:5001",
    "SignalRUrl": "https://sentinela-api:5001/hubs/agent",
    "ApiKey": "",
    "ReconnectDelayMs": 1000,
    "MaxReconnectDelayMs": 30000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
