DB_PASSWORD=sentinela123
REDIS_PASSWORD=sentinela123
RABBITMQ_USER=sentinela
RABBITMQ_PASSWORD=sentinela123
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
GRAFANA_PASSWORD=admin

# SSO (OAuth2) - preencha para habilitar login com Google/Microsoft
SSO_ENABLED=false
SSO_FRONTEND_URL=http://localhost:3000
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=

# Front na Vercel: URL pública da API (ex.: túnel Cloudflare). Vazio = mesmo domínio (Docker).
VITE_API_URL=

# Feed HESK (legado; o painel lê o SGM)
HESK_TOKEN=

# Chamados SGM no SQL Server (não commitar senha)
# Ex.: Server=192.168.0.202,1433;Database=sgm;User Id=USRWINFACT;Password=...;TrustServerCertificate=True;Encrypt=True;
SGM_SQL_CONNECTION=
SGM_APP_BASE_URL=

# Túnel Cloudflare nomeado (URL fixa). Vazio = quick tunnel (URL muda ao reiniciar).
# Crie em https://one.dash.cloudflare.com → Networks → Tunnels → Docker token
CLOUDFLARE_TUNNEL_TOKEN=
